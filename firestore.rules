rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         request.auth.token.email == 'vaultstore27@gmail.com' ||
         request.auth.token.email == 'thunderworld766@gmail.com');
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isOwner(userId);
      allow update: if request.auth != null && (
        isAdmin() || 
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
      );
      allow delete: if isAdmin();
    }

    // Study Sessions Collection
    match /studySessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Day Off records
    match /dayOffs/{userId}/records/{dateKey} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    match /dayOffUsage/{userId}/months/{monthKey} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Targets Collection
    match /targets/{targetId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Notes Collection
    match /notes/{noteId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Doubts Collection
    match /doubts/{doubtId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Announcements Collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs Collection
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Warnings Collection
    match /warnings/{warningId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Syllabi Collection
    match /syllabi/{syllabusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Timer Subjects Collection
    match /timerSubjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Feedbacks Collection
    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Active Study Sessions
    match /activeStudySessions/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Announcement Reads
    match /announcementReads/{readId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Mentor Sessions
    match /mentorSessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Writing Practice Targets
    match /writingPracticeTargets/{targetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Writing Practice Evaluations
    match /writingPracticeEvaluations/{evalId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Writing Practice Submissions
    match /writingPracticeSubmissions/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Weekly Missions
    match /weeklyMissions/{missionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Weekly Mission Progress
    match /weeklyMissionProgress/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Syllabus Completions
    match /syllabusCompletions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Study Daily Stats
    match /studyDailyStats/{statId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // Point Transactions
    match /pointTransactions/{txId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Devices & Security Gate
    match /userDeviceSlots/{userId} {
      allow read, write: if request.auth != null;
    }

    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }

    match /deviceAlerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Study Groups
    match /studyGroups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

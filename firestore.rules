rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && (
        request.auth.token.email == 'vaultstore27@gmail.com' ||
        request.auth.token.email == 'thunderworld766@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function protectedLevelPath(path) {
      return path.matches('levelConfigs/.*') ||
        path.matches('studentLevelData/.*') ||
        path.matches('users/.*/levelHistory/.*') ||
        path.matches('doubts/.*');
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if admin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.points == resource.data.points &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.currentLevel == resource.data.currentLevel &&
        request.resource.data.levelName == resource.data.levelName &&
        request.resource.data.badge == resource.data.badge &&
        request.resource.data.lastNotifiedLevel == resource.data.lastNotifiedLevel &&
        request.resource.data.levelStream == resource.data.levelStream &&
        (
          resource.data.streamLocked != true ||
          (
            (!('stream' in request.resource.data) || request.resource.data.stream == resource.data.stream) &&
            (!('course' in request.resource.data) || request.resource.data.course == resource.data.course) &&
            (!('level' in request.resource.data) || request.resource.data.level == resource.data.level)
          )
        )
      );
      allow delete: if admin();
    }

    match /streamChangeRequests/{requestId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.uid || admin());
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid && request.resource.data.status == 'pending';
      allow update, delete: if admin();
    }

    match /levelConfigs/{streamId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /studentLevelData/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || admin());
      allow write: if admin();
    }

    match /users/{studentId}/levelHistory/{historyId} {
      allow read: if signedIn() && (request.auth.uid == studentId || admin());
      allow write: if admin();
    }

    match /feedbacks/{feedbackId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if admin();
    }

    match /doubts/{doubtId} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if signedIn() && !protectedLevelPath(document);
    }
  }
}
